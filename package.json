{
  "name": "pump-trade-router",
  "version": "0.2.0-beta",
  "private": true,
  "license": "MIT",
  "description": "Standalone Pump/PumpSwap unsigned trade API with automatic routing and a transparent 0.1% fee.",
  "repository": "github:aguilardmarkanthony/pumpfun-trade-api-public",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.mjs",
    "build:check": "wrangler deploy --dry-run",
    "dev": "wrangler dev"
  },
  "dependencies": {
    "@pump-fun/pump-sdk": "4.0.0",
    "@pump-fun/pump-swap-sdk": "2.1.0",
    "@solana/spl-token": "0.4.14",
    "@solana/web3.js": "1.98.4",
    "bigint-buffer": "file:vendor/bigint-buffer",
    "bn.js": "5.2.5",
    "bs58": "6.0.0"
  },
  "overrides": {
    "bn.js": "$bn.js",
    "jayson": "5.0.0",
    "toml": "5.0.0",
    "uuid": "11.1.1",
    "bigint-buffer": "$bigint-buffer"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "wrangler": "4.149.0"
  }
}
