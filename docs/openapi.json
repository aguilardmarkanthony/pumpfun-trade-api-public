  "components": {
    "schemas": {
      "TradeRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "publicKey",
          "mint",
          "action",
          "amount"
        ],
        "properties": {
          "publicKey": {
            "type": "string",
            "minLength": 32,
            "maxLength": 44
          },
          "mint": {
            "type": "string",
            "minLength": 32,
            "maxLength": 44
          },
          "action": {
            "type": "string",
            "enum": [
              "buy",
              "sell"
            ]
          },
          "amount": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 30
              },
              {
                "type": "number",
                "exclusiveMinimum": true,
                "minimum": 0
              }
            ],
            "description": "Buy: SOL up to nine decimals and 100 SOL. Sell: raw integer token units. Exact strings preferred."
          },
          "maxServiceFeeBps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000,
            "description": "Optional service-fee ceiling in basis points. 25 means 0.25%. Quotes and builds fail with 409 FEE_LIMIT_EXCEEDED before upstream calls if the service fee is higher. Does not cap protocol fees, network fees or rent."
          },
          "denominatedInSol": {
            "type": "boolean"
          },
          "pool": {
            "type": "string",
            "enum": [
              "auto",
              "pump",
              "pumpswap"
            ],
            "default": "auto"
          },
          "slippageBps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5000,
            "default": 100
          },
          "slippage": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 50,
            "description": "Legacy percent; mutually exclusive with slippageBps."
          },
          "priorityFee": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000000,
            "default": 0,
            "description": "Maximum priority budget in lamports, not SOL."
          },
          "simulate": {
            "type": "boolean",
            "default": true,
            "description": "Must be true for public Jupiter builds; quotes do not simulate."
          }
        }
      },
      "Quote": {
        "type": "object",
        "required": [
          "venue",
          "quotedOut",
          "expectedOut",
          "minOut",
          "contextSlot",
          "simulation",
          "requestId"
        ],
        "properties": {
          "requestId": {
            "type": "string"
          },
          "venue": {
            "type": "string",
            "enum": [
              "pump",
              "pumpswap"
            ]
          },
          "pool": {
            "type": "string"
          },
          "poolAddress": {
            "type": "string",
            "minLength": 32,
            "maxLength": 44
          },
          "mint": {
            "type": "string",
            "minLength": 32,
            "maxLength": 44
          },
          "action": {
            "type": "string"
          },
          "tradeMode": {
            "type": "string",
            "enum": [
              "exact_input",
              "exact_output_with_max_input"
            ]
          },
          "amountIn": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "inputUnit": {
            "type": "string"
          },
          "quotedOut": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "expectedOut": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "minOut": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "outputUnit": {
            "type": "string"
          },
          "outputAsset": {
            "type": "string"
          },
          "tokenDecimals": {
            "type": "integer"
          },
          "slippageBps": {
            "type": "integer"
          },
          "contextSlot": {
            "type": "integer"
          },
          "serviceFeeBps": {
            "type": "integer",
            "enum": [
              25
            ]
          },
          "feeRecipient": {
            "type": "string",
            "minLength": 32,
            "maxLength": 44
          },
          "feeAsset": {
            "type": "string",
            "enum": [
              "SOL",
              "WSOL"
            ]
          },
          "feeCollection": {
            "type": "string"
          },
          "feeAccount": {
            "type": "string",
            "minLength": 32,
            "maxLength": 44
          },
          "feeRouterProgramId": {
            "type": "string",
            "minLength": 32,
            "maxLength": 44
          },
          "routingProvider": {
            "type": "string"
          },
          "feeBasis": {
            "type": "string"
          },
          "feeIncludedInInput": {
            "type": "boolean"
          },
          "outputIncludesServiceFee": {
            "type": "boolean"
          },
          "feeAccountSetupRequired": {
            "type": "boolean"
          },
          "feeAccountSetupPaidBy": {
            "type": "string"
          },
          "feeAccountSetupRentLamports": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "estimatedServiceFeeLamports": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "maxServiceFeeLamports": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "minNetOut": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "expectedNetOut": {
            "type": "string",
            "pattern": "^[0-9]+$"
          },
          "feeEstimateIsFinal": {
            "type": "boolean"
          },
          "protocolFeesIncluded": {
            "type": "boolean"
          },
          "quoteIsExecutionGuarantee": {
            "type": "boolean"
          },
          "existingWsolAccountPreserved": {
            "type": "boolean"
          },
